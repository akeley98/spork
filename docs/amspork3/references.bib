@article{ATLAS,
title = {Automated empirical optimizations of software and the ATLAS project},
journal = {Parallel Computing},
volume = {27},
number = {1},
pages = {3-35},
year = {2001},
note = {New Trends in High Performance Computing},
issn = {0167-8191},
